# Copy to backend/.env. Never use production patient data for development.
ENVIRONMENT=development
# Restricted login -> dhanvantari_api -> dhanvantari_clinical_actor; never authenticated.
# Remote Supabase URLs require sslmode=verify-full and the trusted sslrootcert path.
DATABASE_URL=postgresql+psycopg://dhanvantari_runtime:REPLACE@127.0.0.1:5432/dhanvantari
# Used only by Alembic/administrative provisioning, never by the web server.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:REPLACE@127.0.0.1:5432/dhanvantari
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=REPLACE
ALLOWED_ORIGIN=http://localhost:8000
COOKIE_SECURE=false
SESSION_TTL_SECONDS=1800
LOGIN_LIMIT=10
LOGIN_WINDOW_SECONDS=900
